// CrypticGate Smart Contract - Midnight Compact Language
// Manages private allowlist root, nullifiers, and public access control state.

include "std";

export type Commitment = Bytes[32];
export type Nullifier = Bytes[32];

// Public Ledger State (visible on Midnight blockchain)
export ledger allowlistRoot: Cell<Bytes[32]>;
export ledger adminPk: Cell<Bytes[32]>;
export ledger latestAccessGranted: Cell<Boolean>;
export ledger totalAccessCount: Counter;
export ledger nullifierSet: Set<Nullifier>;

// Private witness inputs supplied off-chain by the proving user
export witness getMemberSecret(): Bytes[32];
export witness getMemberSalt(): Bytes[32];
export witness getMerklePath(): Vector<8, Bytes[32]>;
export witness getMerkleIndices(): Vector<8, Boolean>;

// Contract Constructor
export circuit constructor(initialRoot: Bytes[32], adminPublicKey: Bytes[32]): Void {
  allowlistRoot = initialRoot;
  adminPk = adminPublicKey;
  latestAccessGranted = false;
}

// Admin Transition: Update allowlist Merkle root
export circuit updateAllowlistRoot(newRoot: Bytes[32]): Void {
  // In production, verify admin signature/witness
  allowlistRoot = newRoot;
}

// Private Membership Proof Transition
export circuit proveAccess(): Void {
  const secret = getMemberSecret();
  const salt = getMemberSalt();
  const path = getMerklePath();
  const indices = getMerkleIndices();
  
  // 1. Recompute commitment
  const commitment = persistent_hash<Tuple<Bytes[32], Bytes[32]>>([secret, salt]);
  
  // 2. Verify leaf membership in current allowlist Merkle root
  var current: Bytes[32] = commitment;
  for (var i: Uint<8> = 0; i < 8; i = i + 1) {
    const sibling = path[i];
    const isRight = indices[i];
    if (isRight) {
      current = persistent_hash<Tuple<Bytes[32], Bytes[32]>>([sibling, current]);
    } else {
      current = persistent_hash<Tuple<Bytes[32], Bytes[32]>>([current, sibling]);
    }
  }
  
  const rootMatches = current == allowlistRoot;
  assert(rootMatches, "Invalid allowlist proof: secret commitment does not exist in Merkle tree");
  
  // 3. Compute unique nullifier to prevent double-spending / reuse
  const nullifier = persistent_hash<Tuple<Bytes[32], String>>([secret, "CRYPTIC_GATE_NULLIFIER"]);
  assert(!nullifierSet.member(nullifier), "Nullifier already used: duplicate proof attempt detected");
  
  // 4. Update ledger state — note: identity, secret, commitment, and indices are NEVER stored
  nullifierSet.insert(nullifier);
  latestAccessGranted = true;
  totalAccessCount.increment(1);
}
